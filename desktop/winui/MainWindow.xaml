<Window x:Class="ChaoxingDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ChaoxingDesktop">
 <Grid x:Name="Root" Background="{ThemeResource WindowBrush}">
  <Grid.Resources>
   <Style x:Key="CategoryItemStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ListViewItem">
       <Border x:Name="CategoryBackground" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates"><VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CategoryBackground.Background" Value="{ThemeResource HoverBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CategoryBackground.Background" Value="{ThemeResource SelectionBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="CategoryBackground.Background" Value="{ThemeResource SelectionBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="CategoryBackground.Background" Value="{ThemeResource SelectionBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="CategoryBackground.Background" Value="{ThemeResource SelectionBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"/>
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
       </Border>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <DataTemplate x:Key="CourseTemplate" x:DataType="local:RecordRow">
    <Border Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,12" HorizontalAlignment="Stretch" Tag="{x:Bind}" Tapped="CourseCardTapped">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
      <CheckBox Width="32" MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind Selected, Mode=OneWay}" Click="CourseChecked" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"/>
      <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource SoftBrush}"><FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="#2563EB"/></Border>
      <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{x:Bind Status, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" Height="5"/></StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate x:Key="RecordTemplate" x:DataType="local:RecordRow">
    <Grid Padding="10" RowSpacing="5" HorizontalAlignment="Stretch">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusForeground, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12"/>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Subtitle, Mode=OneWay}" Foreground="{ThemeResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
     <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" Height="5"/>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource SidebarBrush}" Padding="18">
   <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0"><Border Width="40" Height="40" Background="#2563EB" CornerRadius="10"><FontIcon Glyph="&#xE8F1;" Foreground="White" FontSize="23"/></Border><StackPanel><TextBlock Text="超星" FontSize="21" FontWeight="Bold"/><TextBlock Text="学习工作台" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel></StackPanel>
    <TextBlock Grid.Row="1" Text="WORKSPACE" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource MutedBrush}" Margin="0,26,0,8"/>
    <Grid x:Name="CategoryHost" Grid.Row="2">
    <ListView x:Name="Navigation" ItemContainerStyle="{StaticResource CategoryItemStyle}" SelectionChanged="Navigate" SelectedIndex="0" Background="Transparent">
     <ListViewItem Tag="0"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE8F1;" FontSize="18"/><TextBlock Text="课程与账号"/></StackPanel></ListViewItem>
     <ListViewItem Tag="1"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="学习设置"/></StackPanel></ListViewItem>
     <ListViewItem Tag="2"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE99A;" FontSize="18"/><TextBlock Text="题库与 AI"/></StackPanel></ListViewItem>
     <ListViewItem Tag="3"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE90F;" FontSize="18"/><TextBlock Text="高级设置"/></StackPanel></ListViewItem>
     <ListViewItem Tag="4"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE9D9;" FontSize="18"/><TextBlock Text="任务与日志"/></StackPanel></ListViewItem>
    </ListView>
    <Border x:Name="CategoryIndicator" Width="3" Height="20" CornerRadius="2" Background="#2563EB" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
     <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    </Border>
    </Grid>
    <Border x:Name="PrivacyCard" Grid.Row="3" Background="{ThemeResource SoftBrush}" CornerRadius="10" Padding="13"><StackPanel Spacing="8"><TextBlock Text="本地运行 · 数据由你管理" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="服务凭据在本机加密保存&#xA;登录密码仅用于当前会话" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel></Border>
    <Button x:Name="VersionButton" Grid.Row="4" Content="版本与校验" HorizontalAlignment="Stretch" Click="ShowRelease"/>
   </Grid>
  </Border>
  <Grid x:Name="Workspace" Grid.Column="1" Margin="24" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="Header" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="课程与账号" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource InkBrush}"/><TextBlock x:Name="PageDescription" Text="连接账户，选择课程，开启学习任务。" FontSize="12" Foreground="{ThemeResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False"/><TextBlock x:Name="ModeText" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" FontSize="12"/><Button x:Name="PauseButton" Content="暂停后续" Click="Pause" Visibility="Collapsed"/><Button x:Name="StopButton" Content="停止任务" Click="Stop" Visibility="Collapsed" Foreground="{ThemeResource ErrorBrush}"/><Button x:Name="SaveButton" Content="保存设置" Click="Save" Foreground="White" Background="#0D9488"/></StackPanel>
   </Grid>
   <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在连接本地服务…"/>
   <Grid x:Name="PageHost" Grid.Row="2"/>
   <Grid Grid.Row="3"><TextBlock x:Name="SaveState" Text="设置已同步" Foreground="{ThemeResource MutedBrush}" FontSize="11"/><TextBlock x:Name="Footer" Text="学习工作台 · WinUI 3" HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11"/></Grid>
  </Grid>
 </Grid>
</Window>
