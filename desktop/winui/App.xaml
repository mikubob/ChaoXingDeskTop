<Application x:Class="ChaoxingDesktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="InkBrush" Color="#17243A"/>
   <SolidColorBrush x:Key="MutedBrush" Color="#627086"/>
   <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
   <SolidColorBrush x:Key="WindowBrush" Color="#F6F7FB"/>
   <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F8"/>
   <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
   <SolidColorBrush x:Key="BorderBrush" Color="#E2E7EF"/>
   <SolidColorBrush x:Key="HoverBrush" Color="#E5EBF5"/>
   <SolidColorBrush x:Key="PressedBrush" Color="#D0DDEE"/>
   <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush"/>
   <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedBrush"/>
   <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="InkBrush"/>
   <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="InkBrush"/>
   <StaticResource x:Key="DropDownButtonBackgroundPointerOver" ResourceKey="HoverBrush"/>
   <StaticResource x:Key="DropDownButtonBackgroundPressed" ResourceKey="PressedBrush"/>
   <SolidColorBrush x:Key="SelectionBrush" Color="#DCE8FF"/>
   <SolidColorBrush x:Key="CourseSelectionBrush" Color="#F0F5FF"/>
   <SolidColorBrush x:Key="SoftBrush" Color="#E3EAF5"/>
   <SolidColorBrush x:Key="BannerBrush" Color="#EDF2FC"/>
   <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
   <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
   <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="13"/></Style>
   <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="38"/></Style>
   <Style TargetType="PasswordBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="38"/></Style>
   <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
